@model Football.Web.Models.Match

@{
    ViewData["Title"] = "Create Match";
}

<h1>Create Match</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="SeasonId" class="control-label"></label>
                <select asp-for="SeasonId" class="form-control" asp-items="ViewBag.SeasonId"></select>
                <span asp-validation-for="SeasonId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HomeTeamId" class="control-label"></label>
                <select asp-for="HomeTeamId" class="form-control" asp-items="ViewBag.HomeTeamId"></select>
                <span asp-validation-for="HomeTeamId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AwayTeamId" class="control-label"></label>
                <select asp-for="AwayTeamId" class="form-control" asp-items="ViewBag.AwayTeamId"></select>
                <span asp-validation-for="AwayTeamId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="KickoffDate" class="control-label"></label>
                <input asp-for="KickoffDate" class="form-control" />
                <span asp-validation-for="KickoffDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HomeGoals" class="control-label"></label>
                <input asp-for="HomeGoals" class="form-control" />
                <span asp-validation-for="HomeGoals" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AwayGoals" class="control-label"></label>
                <input asp-for="AwayGoals" class="form-control" />
                <span asp-validation-for="AwayGoals" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Result1X2" class="control-label"></label>
                <input asp-for="Result1X2" class="form-control" />
                <span asp-validation-for="Result1X2" class="text-danger"></span>
            </div>

            <div class="form-group form-check mt-2">
                <input asp-for="IsOver25" class="form-check-input" />
                <label asp-for="IsOver25" class="form-check-label">Is Over 2.5 goals</label>
                <span asp-validation-for="IsOver25" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
